# Qwen / DashScope
# Base API host only, for example:
#   https://maas.qwencloudapi.com
#   https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com
#   https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
API_ENDPOINT=https://maas.qwencloudapi.com
DASHSCOPE_KEY=

# Must match the model used for both voice cloning and realtime conversation
QWEN_MODEL=qwen3.8-omni-flash-realtime

# Voice activity detection on caller audio (helps ignore background noise).
# Raise VAD_THRESHOLD (0-1) if the model reacts to noises; raise
# VAD_SILENCE_DURATION_MS if it interrupts mid-sentence pauses.
VAD_THRESHOLD=0.5
VAD_SILENCE_DURATION_MS=800
VAD_PREFIX_PADDING_MS=300
# Hard floor for turn-end detection: the caller must be this quiet (ms) before
# their answer counts as finished. VAD_SILENCE_DURATION_MS below this is raised.
VAD_MIN_SILENCE_MS=500

# Idle timeout: if no caller speech is heard for this many seconds (counted
# from the end of the receptionist's last word), the call is closed quietly —
# no prompts, no goodbye. 0 = keep the line open forever.
CALL_IDLE_TIMEOUT=60

# App
SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=/app/data
