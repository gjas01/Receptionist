# Qwen / DashScope
# Base API host only, for example:
#   https://maas.qwencloudapi.com
#   https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com
#   https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
API_ENDPOINT=https://maas.qwencloudapi.com
DASHSCOPE_KEY=

# Must match the model used for both voice cloning and realtime conversation
QWEN_MODEL=qwen3.8-omni-flash-realtime

# App
SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=/app/data
